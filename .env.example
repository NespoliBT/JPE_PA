# OpenRouter
OPENROUTER_API_KEY=

# Model
JPE_MODEL=deepseek/deepseek-v4.1-flash-1017
JPE_TEMPERATURE=0.7

# Workspace sandbox
JPE_WORKSPACE=.
JPE_MAX_FILE_BYTES=1000000

# Shell access is off by default; run_command is tier 3 when enabled.
JPE_ALLOW_SHELL=false
JPE_SHELL_TIMEOUT=30

# Documents
JPE_SOUL_PATH=SOUL.md
JPE_POLICY_PATH=POLICY.md

# Tier-3 confirmation token lifetime, in seconds.
JPE_CONFIRMATION_TTL_SECONDS=600

# MCP servers, as a JSON list. This is an allowlist: a server not listed here is
# never started. Each entry needs a "name" and either "command" (stdio) or "url"
# (http). Optional: "args", "env", "headers", "default_tier", "tool_tiers".
# Example:
# JPE_MCP_SERVERS=[{"name":"time","command":"uvx","args":["mcp-server-time"]}]
JPE_MCP_SERVERS=[]
